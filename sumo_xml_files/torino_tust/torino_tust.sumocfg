<?xml version="1.0" encoding="UTF-8"?>

<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="torino_tust.net.xml"/>
        <route-files value="torino_tust.rou.xml,../vehicletypes.rou.xml"/>
        <additional-files value="torino_tust.poly.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="86400"/>
    </time>

</configuration>
